NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for `npm run db:push` only (local; never needed at runtime)
SUPABASE_DB_URL=
ORGANISATION_TIMEZONE=
HOLIDAY_CALENDAR_VERSION=
GITHUB_WEBHOOK_SECRET=

# One-time first-Administrator seed (`npm run db:seed-admin`); password at least 12 characters.
# Remove both from .env.local once the Administrator exists. Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Demo Staff account seed (`npm run db:seed-demo-staff`): a seeded employee's primary email and
# that account's password (at least 12 characters). Never commit real values.
SEED_DEMO_STAFF_EMAIL=
SEED_DEMO_STAFF_PASSWORD=
